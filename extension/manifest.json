{
  "manifest_version": 3,
  "name": "Milheirinho Coletor",
  "description": "Coleta preços em milhas da Smiles, Azul e LATAM para o Milheirinho: pega buscas da ponte (no PC ou no homelab), abre a busca do programa e devolve o resultado.",
  "version": "0.6.0",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://www.voeazul.com.br/*",
    "https://www.latamairlines.com/*",
    "https://www.smiles.com.br/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.voeazul.com.br/*",
        "https://www.latamairlines.com/*",
        "https://www.smiles.com.br/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.voeazul.com.br/*",
        "https://www.latamairlines.com/*",
        "https://www.smiles.com.br/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Milheirinho Coletor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
