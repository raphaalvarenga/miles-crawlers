{
  "manifest_version": 3,
  "name": "Miles Fetcher",
  "description": "Busca disponibilidade em pontos/milhas (Azul, LATAM) para o Miles: pega jobs da ponte local, abre a busca e devolve o JSON da API.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://www.voeazul.com.br/*",
    "https://www.latamairlines.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.voeazul.com.br/*",
        "https://www.latamairlines.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.voeazul.com.br/*",
        "https://www.latamairlines.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Miles Fetcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
